rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.email == 'berkayincee17@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); 
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'imageUrl', 'linkUrl', 'isFeatured', 'createdAt'])
        && data.keys().size() == 7
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 500
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500
        && data.linkUrl is string && data.linkUrl.size() > 0 && data.linkUrl.size() <= 500
        && data.isFeatured is bool
        && data.createdAt is timestamp;
    }

    function isValidDemo(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'imageUrl', 'linkUrl', 'createdAt'])
        && data.keys().size() == 6
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 500
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500
        && data.linkUrl is string && data.linkUrl.size() > 0 && data.linkUrl.size() <= 500
        && data.createdAt is timestamp;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isValidId(projectId) && isValidProject(incoming());
      allow update: if isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(projectId);
    }
    
    match /demos/{demoId} {
      allow read: if true;
      allow create: if isValidId(demoId) && isValidDemo(incoming());
      allow update: if isValidId(demoId) && isValidDemo(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(demoId);
    }
    
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
